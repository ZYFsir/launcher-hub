{
  "id": "llama",
  "name": "llama.cpp",
  "subtitle": "本地推理 · Vulkan",
  "kind": "llama",
  "accent": "#F26B3A",
  "launch": {
    "type": "powershell",
    "command": "scripts/start-llama.ps1",
    "args": [],
    "cwd": ".",
    "stop": "process-tree"
  },
  "health": {
    "type": "http",
